{
  "week": 1,
  "lessons": [
    {
      "id": "w1-l1",
      "week": 1,
      "order": 1,
      "title": "Seven sounds, one shape",
      "goal": "Learn the 7 vowel orders using the አ and ለ families.",
      "newFamilies": [
        "አ",
        "ለ"
      ],
      "estimatedMinutes": 15,
      "cultureNote": "Ethiopian children learn the fidel by chanting each family across its seven orders: ሀ ሁ ሂ ሃ ሄ ህ ሆ. The app's 'chant' button does the same.",
      "steps": [
        {
          "type": "intro",
          "text": "Amharic letters come in families. Each family has 7 forms — one per vowel. Learn the 7 vowel marks once, and they work for every family."
        },
        {
          "type": "hear",
          "items": [
            "አ",
            "ኡ",
            "ኢ",
            "ኣ",
            "ኤ",
            "እ",
            "ኦ"
          ],
          "text": "Listen to the 7 vowel sounds: a, u, i, a, ē, ə, o."
        },
        {
          "type": "see",
          "family": "ለ",
          "text": "Watch how ለ changes: a foot for u, a little leg for i, a lowered leg for a, a ring for ē, a bent stem for ə, a loop for o."
        },
        {
          "type": "chant",
          "family": "ለ"
        },
        {
          "type": "trace",
          "chars": [
            "አ",
            "ለ",
            "ሉ",
            "ላ",
            "ሎ"
          ]
        },
        {
          "type": "exercise",
          "kind": "soundMatch",
          "prompt": "ሉ",
          "options": [
            "ለ",
            "ሉ",
            "ሊ",
            "ላ"
          ]
        },
        {
          "type": "exercise",
          "kind": "soundMatch",
          "prompt": "ሎ",
          "options": [
            "ሌ",
            "ል",
            "ሎ",
            "ሊ"
          ]
        },
        {
          "type": "exercise",
          "kind": "gridFill",
          "family": "ለ",
          "hide": [
            3,
            5
          ]
        },
        {
          "type": "say",
          "items": [
            "ለ",
            "ሉ",
            "ሊ",
            "ላ",
            "ሌ",
            "ል",
            "ሎ"
          ]
        },
        {
          "type": "phrase",
          "word": {
            "id": "selam",
            "amharic": "ሰላም",
            "roman": "selam",
            "english": "hello / peace",
            "picture": "🕊️",
            "audio": "/audio/words/selam.mp3",
            "reviewed": false,
            "note": "You'll learn to read this in lesson 2 — for now, just hear and say it."
          }
        },
        {
          "type": "wrapUp",
          "text": "You can already read 14 characters. Tomorrow: መ and ሰ."
        }
      ]
    },
    {
      "id": "w1-l2",
      "week": 1,
      "order": 2,
      "title": "Hello, name, mother",
      "goal": "Add the መ and ሰ families and read your first words.",
      "newFamilies": [
        "መ",
        "ሰ"
      ],
      "estimatedMinutes": 18,
      "cultureNote": "ሰላም (selam) means peace. It is the everyday greeting — and many Ethiopian girls are named Selam.",
      "steps": [
        {
          "type": "review"
        },
        {
          "type": "hear",
          "items": [
            "መ",
            "ሙ",
            "ሚ",
            "ማ",
            "ሜ",
            "ም",
            "ሞ",
            "ሰ",
            "ሱ",
            "ሲ",
            "ሳ",
            "ሴ",
            "ስ",
            "ሶ"
          ]
        },
        {
          "type": "see",
          "family": "መ"
        },
        {
          "type": "see",
          "family": "ሰ"
        },
        {
          "type": "rule",
          "title": "The 6th order does double duty",
          "text": "ስ and ም can be 'sə'/'mə' or just 's'/'m' with no vowel. So ስም is 'səm' (name), not 'sə-mə'."
        },
        {
          "type": "trace",
          "chars": [
            "መ",
            "ማ",
            "ሰ",
            "ሳ",
            "ስ",
            "ም"
          ]
        },
        {
          "type": "words",
          "items": [
            {
              "id": "selam",
              "amharic": "ሰላም",
              "roman": "selam",
              "english": "hello / peace",
              "picture": "🕊️",
              "audio": "/audio/words/selam.mp3",
