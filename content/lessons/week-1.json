            "ም",
            "ሰ",
            "ሊ"
          ]
        },
        {
          "type": "exercise",
          "kind": "minimalPair",
          "note": "Hear the held m",
          "a": {
            "id": "semma",
            "amharic": "ሰማ",
            "roman": "semma",
            "english": "he heard",
            "picture": "👂",
            "audio": "/audio/words/semma.mp3",
            "reviewed": false
          },
          "b": {
            "id": "sema",
            "amharic": "ሰማ",
            "roman": "sema",
            "english": "(no doubling)",
            "picture": "🔈",
            "audio": "/audio/words/sema.mp3",
            "reviewed": false,
            "note": "Contrast audio only — record a short m."
          }
        },
        {
          "type": "exercise",
          "kind": "dictation",
          "target": "ስም"
        },
        {
          "type": "say",
          "items": [
            "ሰላም",
            "እማማ",
            "ስም"
          ]
        },
        {
          "type": "wrapUp",
          "text": "Four families, four real words. Tomorrow: በ, and you'll read a mini story."
        }
      ]
    },
