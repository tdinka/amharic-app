    {
      "id": "w5-l3",
      "week": 5,
      "order": 3,
      "title": "Language, friend, ball",
      "goal": "Add ኸ, and read letters with a w: ቋ ጓ ኳ ሏ.",
      "newFamilies": [
        "ኸ"
      ],
      "newLabialized": [
        "ቋ",
        "ጓ",
        "ኳ",
        "ሏ"
      ],
      "estimatedMinutes": 18,
      "cultureNote": "ጓደኛ means friend. Friends who haven't seen each other for a while often greet with kisses on alternating cheeks — three or more — and men who know each other well often touch shoulders.",
