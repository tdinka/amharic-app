# Copy this file to .env.local and fill in the values. .env.local is never committed.

# Google Cloud Text-to-Speech API key, for `npm run audio:tts` (temporary computer voices).
GOOGLE_TTS_API_KEY=

# Optional: a specific Amharic voice, e.g. am-ET-Wavenet-A. The script lists the choices.
GOOGLE_TTS_VOICE=
